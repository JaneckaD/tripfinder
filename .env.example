# Zkopíruj jako .env a doplň klíče. Bez klíčů aplikace běží s ukázkovými daty.

# Databáze Turso (volitelné lokálně, na hostingu nutné). Bez nich se použije soubor ./data/tripfinder.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Letenky – Travelpayouts (Aviasales Data API), zdarma: https://www.travelpayouts.com
TRAVELPAYOUTS_TOKEN=
# Volitelné: tvůj partnerský "marker" (provize z rezervací přes odkazy)
TRAVELPAYOUTS_MARKER=

# Google Flights + Google Hotels přes SerpApi, 250 hledání/měsíc zdarma: https://serpapi.com
SERPAPI_KEY=
# Pojistka, aby se nepřekročil bezplatný limit (počítá se jedno hledání = jedno volání)
SERPAPI_MONTHLY_LIMIT=240

# Hotely – LiteAPI, registrace zdarma: https://dashboard.liteapi.travel
LITEAPI_KEY=

PORT=3000
