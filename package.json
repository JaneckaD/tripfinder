{
  "name": "tripfinder",
  "version": "0.1.0",
  "description": "TripFinder – PWA pro hledání a plánování výletů po světě (doprava, ubytování, ceny, spolucestující).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "compression": "^1.8.1",
    "countries-list": "^3.4.1",
    "express": "^5.1.0",
    "leaflet": "^1.9.4"
  }
}
